lLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="1460" y="150" width="60" height="60" as="geometry" /></mxCell><mxCell id="c26" value="Internet&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="60" height="60" as="geometry" /></mxCell><mxCell id="c27" value="&lt;b&gt;ALB :80&lt;/b&gt; (service stack)&lt;br&gt;listener to blue target group&lt;br&gt;green target group used in releases" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="1010" y="500" width="60" height="60" as="geometry" /></mxCell><mxCell id="c28" value="Fargate task&lt;br&gt;orders-app :8080" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="60" height="60" as="geometry" /></mxCell><mxCell id="c29" value="Fargate task&lt;br&gt;orders-app :8080" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="1120" y="700" width="60" height="60" as="geometry" /></mxCell><mxCell id="c30" value="Interface endpoints&lt;br&gt;ecr.api, ecr.dkr, logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="730" y="700" width="60" height="60" as="geometry" /></mxCell><mxCell id="c31" value="Interface endpoints&lt;br&gt;ecr.api, ecr.dkr, logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="1290" y="700" width="60" height="60" as="geometry" /></mxCell><mxCell id="c32" value="S3 gateway endpoint&lt;br&gt;(image layers)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="900" y="700" width="60" height="60" as="geometry" /></mxCell><mxCell id="c33" value="&lt;b&gt;ECS service&lt;/b&gt; onward-dev-orders-service in cluster onward-dev-orders-cluster (service stack)&lt;br&gt;2 to 6 tasks, target tracking on CPU 50%, deployment controller: CodeDeploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="840" width="1020" height="54" as="geometry" /></mxCell><mxCell id="c34" value="Route table: local + S3 only. No 0.0.0.0/0 route, so no path to the internet." style="text;html=1;fontSize=10;fontColor=#147EBA;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="540" y="920" width="440" height="40" as="geometry" /></mxCell><mxCell id="c35" value="Route table: local + S3 only. No 0.0.0.0/0 route, so no path to the internet." style="text;html=1;fontSize=10;fontColor=#147EBA;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="920" width="440" height="40" as="geometry" /></mxCell><mxCell id="c36" value="Customers and&lt;br&gt;merchants" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#147EBA;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="160" y="535" width="60" height="60" as="geometry" /></mxCell><mxCell id="c37" value="&lt;b&gt;Release flow (orange)&lt;/b&gt;&lt;br&gt;1 Engineer merges a change to main&lt;br&gt;2 GitHub Actions starts and builds the image&lt;br&gt;3 OIDC: GitHub gets temporary AWS credentials&lt;br&gt;4 Image pushed to ECR as :commit and :latest&lt;br&gt;5 EventBridge sees the new :latest image&lt;br&gt;6 CodePipeline starts and reads deploy/ files&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;from the app repo&lt;br&gt;7 CodePipeline hands image + task definition&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;to CodeDeploy&lt;br&gt;8 CodeDeploy starts green tasks, sends 10% of&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;traffic for 5 min, then 100%. Blue kept 10 min&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;for instant rollback&lt;br&gt;&lt;br&gt;&lt;b&gt;Customer flow (blue)&lt;/b&gt;&lt;br&gt;Customers to ALB to tasks in private subnets&lt;br&gt;&lt;br&gt;&lt;b&gt;Private access (dashed)&lt;/b&gt;&lt;br&gt;Tasks pull images and send logs through&lt;br&gt;VPC endpoints, never the internet&lt;br&gt;&lt;br&gt;&lt;b&gt;Stacks&lt;/b&gt;&lt;br&gt;Bootstrap: OIDC provider, GitHub role, ECR&lt;br&gt;Network: VPC, subnets, VPC endpoints&lt;br&gt;Service: ALB, target groups, ECS, scaling&lt;br&gt;Delivery: EventBridge, CodePipeline, CodeDeploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="320" height="430" as="geometry" /></mxCell><mxCell id="c38" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B35900;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c39" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B35900;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c40" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B35900;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="318" /><mxPoint x="360" y="180" /></Array></mxGeometry></mxCell><mxCell id="c41" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#B35900;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c42" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ED7100;strokeWidth=2;endArrow=block;