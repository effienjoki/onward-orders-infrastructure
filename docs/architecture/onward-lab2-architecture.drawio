="1" parent="1"><mxGeometry x="1580" y="1010" width="60" height="60" as="geometry" /></mxCell><mxCell id="c60" value="S3 gateway&lt;br&gt;endpoint" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="1740" y="1010" width="60" height="60" as="geometry" /></mxCell><mxCell id="c61" value="Route table: local + S3 only. No 0.0.0.0/0, so no path to the internet." style="text;html=1;fontSize=10;fontColor=#147EBA;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="1220" width="420" height="36" as="geometry" /></mxCell><mxCell id="c62" value="Task SG: 8080 from the ALB SG only. Endpoint SG: 443 from the VPC only. No public IPs." style="text;html=1;fontSize=10;fontColor=#147EBA;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="1258" width="420" height="36" as="geometry" /></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6B86;strokeWidth=1.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#5A6B86;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c57" target="c59"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6B86;strokeWidth=1.2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#5A6B86;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.67;" edge="1" parent="1" source="c58" target="c59"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="1160" /><mxPoint x="1540" y="1050" /></Array></mxGeometry></mxCell><mxCell id="c65" value="&lt;b&gt;ECS service&lt;/b&gt; onward-dev-orders-service (service child stack): Fargate tasks in both private subnets, 1 to 6 tasks (dev minimum 1), target tracking on CPU 50%, deployment controller CodeDeploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="1300" width="1280" height="60" as="geometry" /></mxCell><mxCell id="c66" value="&lt;b&gt;Infrastructure deploy (dark grey)&lt;/b&gt;&lt;br&gt;A Push to templates/&lt;br&gt;B package: child templates uploaded to S3&lt;br&gt;C deploy: root stack, built with the deploy role,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;creates network, service, delivery children&lt;br&gt;Bootstrap is one template, deployed by Git sync&lt;br&gt;&lt;br&gt;&lt;b&gt;Release flow (orange)&lt;/b&gt;&lt;br&gt;1 Engineer merges to main&lt;br&gt;2 GitHub Actions builds the image&lt;br&gt;3 OIDC: temporary credentials, no stored keys&lt;br&gt;4 Image pushed to ECR (:commit and :latest)&lt;br&gt;5 EventBridge sees the new :latest image&lt;br&gt;6 CodePipeline reads deploy/ files from the app repo&lt;br&gt;7 CodePipeline hands image + task definition to CodeDeploy&lt;br&gt;8 CodeDeploy starts green tasks in both zones,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;shifts 10% for 5 min, then 100%, keeps blue 10 min&lt;br&gt;&lt;br&gt;&lt;b&gt;Customer flow (blue)&lt;/b&gt;&lt;br&gt;Customers to internet gateway to ALB nodes&lt;br&gt;to tasks in both private subnets&lt;br&gt;&lt;br&gt;&lt;b&gt;Private access (dashed)&lt;/b&gt;&lt;br&gt;Tasks in both zones pull images and send logs&lt;br&gt;through the VPC endpoints, never the internet&lt;br&gt;&lt;br&gt;&lt;b&gt;Scaling (red, dashed)&lt;/b&gt;&lt;br&gt;CPU above 50%: Application Auto Scaling adds tasks&lt;br&gt;up to 6, then removes them back to 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="840" w